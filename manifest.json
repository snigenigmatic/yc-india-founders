{
  "manifest_version": 3,
  "name": "YC India-Origin Founder Finder",
  "version": "1.0.0",
  "description": "Filter the YC founders directory for founders and co-founders with Indian-origin signals in recent batches, with LinkedIn links and CSV export.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Find India-origin YC founders",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ycombinator.com/founders*",
        "https://www.ycombinator.com/companies",
        "https://www.ycombinator.com/companies?*"
      ],
      "js": ["src/names.js", "src/scoring.js", "src/data.js", "src/panel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel.css"],
      "matches": ["https://www.ycombinator.com/*"]
    }
  ]
}
